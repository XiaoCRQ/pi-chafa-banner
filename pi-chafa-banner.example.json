{
  "$schema": "./pi-chafa-banner.schema.json",
  "version": 2,
  "image": {
    "path": "~/Pictures/logo/v-3.gif",
    "fps": "auto",
    "stride": 3,
    "chafa": ""
  },
  "width": 88,
  "height": 17,
  "gap": {
    "width": 2,
    "height": 1
  },
  "variableWidth": false,
  "variableHeight": false,
  "compactWidth": 32,
  "layout": {
    "type": "layout",
    "mode": "horizontal",
    "children": [
      {
        "type": "layout",
        "weight": 5,
        "mode": "vertical",
        "children": [
          {
            "type": "chafa",
            "weight": 1
          },
          {
            "type": "window",
            "weight": 1,
            "title": "CODING AGENT",
            "content": [
              {
                "type": "inline",
                "title": "Version",
                "content": "version"
              },
              {
                "type": "inline",
                "title": "Model",
                "content": "model"
              }
            ]
          }
        ]
      },
      {
        "type": "window",
        "weight": 5,
        "title": "RESOURCES",
        "content": [
          {
            "type": "outline",
            "title": "Context",
            "content": "context"
          },
          {
            "type": "outline",
            "title": "Skills",
            "content": "skills"
          },
          {
            "type": "outline",
            "title": "Extensions",
            "content": "extensions",
            "stacked": true
          }
        ]
      }
    ]
  },
  "theme": {
    "preset": "tokyonight",
    "windowTitle": "#7aa2f7",
    "sectionTitle": "#bb9af7",
    "border": "#3b4261",
    "content": "#a9b1d6"
  },
  "behavior": {
    "enabled": true,
    "static": false,
    "hidePiResourceList": true
  }
}
