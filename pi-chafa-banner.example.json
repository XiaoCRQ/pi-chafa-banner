{
  "$schema": "./pi-chafa-banner.schema.json",
  "version": 1,
  "image": {
    "path": "~/Pictures/logo/v-3.gif",
    "width": 44,
    "height": "auto",
    "fps": "auto",
    "stride": 3,
    "chafa": ""
  },
  "layout": {
    "width": 88,
    "gap": 4,
    "twoColumnMinWidth": 76,
    "compactMinWidth": 32,
    "maxWidth": 108,
    "lowerRows": 12
  },
  "panels": {
    "info": {
      "enabled": true,
      "fields": [
        "version",
        "model",
        "theme"
      ]
    },
    "resources": {
      "enabled": true,
      "sections": [
        "context",
        "skills",
        "themes",
        "extensions"
      ],
      "width": "auto",
      "height": "auto",
      "maxLinesPerSection": 6
    }
  },
  "behavior": {
    "enabled": true,
    "static": false,
    "hidePiResourceList": true
  }
}
